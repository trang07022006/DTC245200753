# -------------------------------------------------------------
# DTC245200753 - Hệ thống Thư viện Ảnh Gallery
# File mẫu biến môi trường (.env.example)
# Khi triển khai thật, sao chép file này thành .env và đổi mật khẩu an toàn
# -------------------------------------------------------------

# Cổng truy cập bên ngoài Host
APP_PORT=80
PMA_PORT=8082

# Cấu hình Cơ sở dữ liệu MySQL
MYSQL_DATABASE=gallery_db
MYSQL_USER=gallery_user
MYSQL_PASSWORD=gallery_password_change_me
MYSQL_ROOT_PASSWORD=root_password_change_me

# Giới hạn dung lượng tải lên (bytes) - Mặc định 5MB (5 * 1024 * 1024)
UPLOAD_MAX_BYTES=5242880
